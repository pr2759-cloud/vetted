# Environment Configuration
# Copy this file to .env and update the values

# Application Settings
NODE_ENV=development
APP_NAME=Vetted
APP_VERSION=1.0.0

# Server Configuration
FRONTEND_PORT=3000
BACKEND_PORT=3001

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Database Configuration
MONGODB_URI=mongodb://admin:password@localhost:27017/vetted?authSource=admin
MONGODB_TEST_URI=mongodb://admin:password@localhost:27017/vetted_test?authSource=admin

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# External Services (Optional - for future integrations)
# E-commerce APIs
AMAZON_API_KEY=
AMAZON_SECRET_KEY=
SHOPIFY_API_KEY=
SHOPIFY_SECRET_KEY=

# Analytics APIs
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# Social Media APIs (for sentiment analysis)
TWITTER_API_KEY=
REDDIT_API_KEY=

# Email Service (for notifications)
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloud Storage (for product images)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=us-east-1

# Search & Discovery
ELASTICSEARCH_URL=http://localhost:9200
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=

# Monitoring & Error Tracking
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Development Tools
DEBUG=vetted:*
WEBPACK_ANALYZE=false

# Production Settings (Override in production)
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=
DOMAIN=localhost

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_CACHING=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_RECOMMENDATIONS=true
ENABLE_USER_ACCOUNTS=false

# Performance
MAX_FILE_SIZE=10mb
REQUEST_TIMEOUT=30000
CACHE_TTL=300

# CORS Settings
CORS_ORIGIN=http://localhost:3000
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE
CORS_CREDENTIALS=true
